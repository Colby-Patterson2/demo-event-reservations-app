# Shared deployment values (fill once, then copy into app settings below)
AZURE_LOCATION="eastus"
RESOURCE_GROUP_NAME="rg-events-mvp"
COSMOS_ACCOUNT_NAME="cosmos-events-mvp"
DEPLOY_COSMOS_DB_DATABASE_ID="reservations"
DEPLOY_COSMOS_DB_CONTAINER_ID="events"
DEPLOY_COSMOS_DB_ENDPOINT="https://<account>.documents.azure.com:443/"
DEPLOY_COSMOS_DB_KEY="<primary-key-from-azure-portal>"

# Function app settings (for `functions/src/services/cosmosClient.ts`)
FUNCTIONS_WORKER_RUNTIME="node"
COSMOS_DB_ENDPOINT="https://<account>.documents.azure.com:443/"
COSMOS_DB_KEY="<primary-key-from-azure-portal>"
COSMOS_DB_DATABASE_ID="reservations"
COSMOS_DB_CONTAINER_ID="events"

# Web app runtime settings (for `web/app/events/[id]/actions.ts`)
# Keep AZURE_FUNCTION_RESERVE_URL as the endpoint URL only.
# Pass AZURE_FUNCTION_KEY separately in the x-functions-key header.
AZURE_FUNCTION_RESERVE_URL="https://<function-app-name>.azurewebsites.net/api/reserve-seat"
AZURE_FUNCTION_KEY="<function-key-from-portal-or-cli>"
