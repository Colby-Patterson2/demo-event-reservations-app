# Azure Cosmos DB for reservations and inventory.
# Create: Azure portal > Cosmos DB > Create new account (free tier for MVP).
# After provisioning, copy the values from the account keys/connection strings page.
COSMOS_DB_ENDPOINT="https://<account>.documents.azure.com:443/"
COSMOS_DB_KEY="<primary-key-from-azure-portal>"
COSMOS_DB_DATABASE_ID="reservations"
COSMOS_DB_CONTAINER_ID="events"

# Azure Function configuration.
# The function app reserves this key for authLevel:"function" endpoints.
# Generate a unique key for MVP: use any strong random string or let Azure generate one.
AZURE_FUNCTION_RESERVE_URL="https://<function-app-name>.azurewebsites.net/api/reserve-seat?code=<function-key>"
AZURE_FUNCTION_KEY="<function-key>"

# Next.js web app configuration.
# These are injected as environment variables when the web container starts.
NEXT_PUBLIC_API_URL="${AZURE_FUNCTION_RESERVE_URL}"
